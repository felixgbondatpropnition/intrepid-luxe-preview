---
import { existsSync } from 'node:fs';
import { formatDate, url } from '../data/site';
const { post, level = 2, row = false } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
const d = post.data;
// Cards show a smaller copy of the photo (name-900.jpg, JPG only) when there is one, so list pages stay quick.
const small = d.image?.replace(/\.jpg$/, '-900.jpg');
const thumb = small && small !== d.image && existsSync(`public/img/${small}`) ? small : d.image;
---
<article class:list={['card', { 'card--row': row }]}>
  <a href={url(`/journal/${post.id}/`)}>
    <div class="card__img">
      <img src={url(`/img/${thumb ?? 'sunset-sea-900.jpg'}`)} alt={d.imageAlt} loading="lazy" width="900" height="675" style={d.image ? `object-position:${d.imagePosition}` : undefined} />
    </div>
    <div class="card__body">
      <span class="card__meta"><span class="card__cat">{d.category}</span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
      <Heading>{d.title}</Heading>
      <p>{d.summary}</p>
      <span class="card__more">Read more</span>
    </div>
  </a>
</article>
