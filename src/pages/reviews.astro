---
import { url } from '../data/site';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Banner from '../components/Banner.astro';
import Cta from '../components/Cta.astro';
import ReviewCard from '../components/ReviewCard.astro';

const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
---
<Base
  title="Reviews"
  description="What clients say about their Intrepid Luxe holidays."
  image="pool.jpg"
>
  <Banner title="Reviews" image="pool.jpg" intro="What clients say about their Intrepid Luxe holidays." />
  <section class="section">
    <div class="wrap">
      {reviews.length ? (
        <div class="reviews reviews--list" data-stagger>{reviews.map((review) => <ReviewCard review={review} />)}</div>
      ) : (
        <p class="empty">Client reviews will appear here. To hear how Intrepid Luxe could plan your next holiday, <a href={url('/contact/')}>get in touch</a>.</p>
      )}
    </div>
  </section>
  <Cta />
</Base>
