---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Banner from '../../../components/Banner.astro';
import Cta from '../../../components/Cta.astro';
import JournalList from '../../../components/JournalList.astro';
import { CATEGORIES, categorySlug } from '../../../data/site';

export function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: categorySlug(category) }, props: { category } }));
}

const { category } = Astro.props;
const posts = (await getCollection('journal', (p) => p.data.category === category)).sort((a, b) => +b.data.date - +a.data.date);
---
<Base
  title={`${category} | The Intrepid Journal`}
  description={`${category} articles from the Intrepid Journal by Intrepid Luxe.`}
  image="harbour-sunset.jpg"
>
  <Banner title={category} image="harbour-sunset.jpg" />
  <JournalList posts={posts} active={category} />
  <Cta />
</Base>
