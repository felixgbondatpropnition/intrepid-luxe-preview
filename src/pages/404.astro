---
import { url } from '../data/site';
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <section class="notfound">
    <div class="wrap">
      <h1>This page has wandered off</h1>
      <p>We could not find what you were looking for.</p>
      <div class="btn-row" style="justify-content:center"><a class="btn" href={url('/')}>Back to the home page</a></div>
    </div>
  </section>
</Base>
